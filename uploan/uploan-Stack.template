     "ELB": {
         "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
         "Properties": {
             "Scheme": "internet-facing",
             "Subnets": [
                { "Ref": "AZ1PublicSubnetID" },
                { "Ref": "AZ2PublicSubnetID" }
             ],
             "LoadBalancerAttributes": [
                { "Key": "idle_timeout.timeout_seconds", "Value": "50" },
                { "Key": "routing.http2.enabled", "Value": "true" },
                { "Key": "deletion_protection.enabled", "Value": "false" }
             ],
             "SecurityGroups": [{ "Ref": "ELBSecurityGroup" }, { "Ref": "ELBDevAccessSecurityGroup" }],
             "Tags": [{
                "Key": "Name",
                "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "ELB" ] ] }
             }]
         }
     },
     "PublicELBLMSTargetGroup": {
        "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
         "Properties": {
             "HealthCheckIntervalSeconds": 30,
             "HealthCheckProtocol": "HTTP",
             "HealthCheckTimeoutSeconds": 10,
             "HealthyThresholdCount": 4,
             "Matcher": { "HttpCode": "200,301" },
             "Name": { "Fn::Join": [ "-", [ { "Ref" : "AWS::StackName"}, "LMS-Target-Group" ] ] },
             "Port": 80,
             "Protocol": "HTTP",
             "VpcId": { "Ref": "VPC" },
             "TargetGroupAttributes": [{
                 "Key": "deregistration_delay.timeout_seconds",
                 "Value": "20"
             }],
             "Targets": [ { "Id": { "Ref": "LMSInstance" } , "Port": 8080 }] 
          }
     },
     "PublicELBWilliamTargetGroup": {
        "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
         "Properties": {
             "HealthCheckIntervalSeconds": 30,
             "HealthCheckProtocol": "HTTP",
