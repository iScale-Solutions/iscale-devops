               "Value" : { "Ref" : "DBInstance" }
            }]
         }
    },
    "DBLowStorageAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "Low Storage Alarm for", { "Ref" : "AWS::StackName"}, "DB Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "FreeStorageSpace",
            "Namespace" : "AWS/RDS",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "1000000000",
            "ComparisonOperator" : "LessThanThreshold",
            "Dimensions" : [ {
               "Name" : "InstanceId",
               "Value" : { "Ref" : "DBInstance" }
            }]
         }
     },
     "RedisReplicationGroup": {
       "Type": "AWS::ElastiCache::ReplicationGroup",
       "Properties": {
          "AtRestEncryptionEnabled": "true",
          "TransitEncryptionEnabled": "true",
          "AutomaticFailoverEnabled": { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "RedisAutomaticFailoverEnabled" ] },
          "AutoMinorVersionUpgrade": "true",
          "CacheSubnetGroupName": { "Ref": "RedisSubnetGroup" },
          "Engine": "redis",
          "EngineVersion": "5.0.4",
          "CacheNodeType": { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "RedisNodeType" ] },
          "NumCacheClusters": { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "RedisNbNodes" ] },
          "ReplicationGroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Redis Replication Group" ] ] },
          "SnapshotRetentionLimit": { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "RedisRetentionPeriod" ] },
          "SecurityGroupIds": [{
             "Fn::GetAtt": [
                "RedisSecurityGroup",
                "GroupId"
             ]}
           ],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Redis Replication Group" ] ] }
           }]
        },
        "DeletionPolicy": "Snapshot"
     },
     "RedisRoute53Record" : {
       "Type" : "AWS::Route53::RecordSet",
       "Properties" : {
          "HostedZoneName" : { "Fn::Join" : [ "", [ { "Ref" : "LocalDomainName" }, "." ]]}, 
          "Comment" : "Local DNS for Redis",
          "Name" : {
             "Fn::Join" : [ "", [
                {"Ref" : "AWS::StackName"}, ".redis.",
                {"Ref" : "LocalDomainName"} ,"."
             ] ]
          },
          "Type" : "CNAME",
          "TTL" : "60",
          "ResourceRecords" : [
             { "Fn::GetAtt" : [ "RedisReplicationGroup", "PrimaryEndPoint.Address" ] }
          ]
       }
     },
     "RedisCPUAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "CPU Alarm for", { "Ref" : "AWS::StackName"}, "Redis Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "CPUUtilization",
            "Namespace" : "AWS/ElastiCache",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "80",
            "ComparisonOperator" : "GreaterThanThreshold",
            "Dimensions" : [ {
               "Name" : "InstanceId",
               "Value" : { "Ref" : "RedisReplicationGroup" }
            }]
         }
     },
     "RedisLowMemoryAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "Low Memory Alarm for", { "Ref" : "AWS::StackName"}, "Redis Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "FreeableMemory",
            "Namespace" : "AWS/ElastiCache",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "200000000",
            "ComparisonOperator" : "LessThanThreshold",
            "Dimensions" : [ {
