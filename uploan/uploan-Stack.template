{
  "AWSTemplateFormatVersion" : "2010-09-09",
  "Description" : "Uploan Stack Setup",
  "Parameters" : {
    "KeyName" : {
      "Description" : "Name of an existing EC2 KeyPair for App Server",
      "Type" : "AWS::EC2::KeyPair::KeyName",
      "ConstraintDescription" : "must be the name of an existing EC2 KeyPair."
    },
    "AppServerAMI": {
       "Description": "Name of AppServer (LMS / William) AMI",
       "MinLength": "1",
       "Type": "AWS::EC2::Image::Id",
       "ConstraintDescription": "AppServer AMI cannot be null"
    },
    "WellnessServerAMI": {
       "Description": "Name of Wellness Server AMI (only staging and prod)",
       "Type": "AWS::EC2::Image::Id"
    },
    "WWWServerAMI": {
       "Description": "Name of WWW Server AMI (only staging and prod)",
       "Type": "AWS::EC2::Image::Id"
    },
    "DomainName" : {
      "Description" : "Setup Domain Name",
      "Type" : "String",
      "Default" : "uploan-qa.com",
      "ConstraintDescription" : "must be a valid domain name"
    },
    "SubDomainName" : {
      "Description" : "SubDomain Name",
      "Type" : "String",
      "ConstraintDescription" : "must be a valid domain name"
    },
    "LocalDomainName" : {
      "Description" : "Local Domain Name",
      "Type" : "String",
      "Default" : "uploan.qa", 
      "ConstraintDescription" : "must be a valid domain name"
    },
    "VPC" : {
      "Description" : "VPC to deploy into",
      "Type" : "AWS::EC2::VPC::Id"
    },
    "AZ1PublicSubnetID" : {
      "Type" : "AWS::EC2::Subnet::Id",
      "Description" : "VPC public subnet for AZ1",
      "ConstraintDescription" : "Must be an existing subnet in the selected Virtual Private Cloud."
    },
    "AZ2PublicSubnetID" : {
      "Type" : "AWS::EC2::Subnet::Id",
      "Description" : "VPC public subnet for AZ2",
      "ConstraintDescription" : "Must be an existing subnet in the selected Virtual Private Cloud."
    },
    "AZ1PrivateSubnetID" : {
      "Type" : "AWS::EC2::Subnet::Id",
      "Description" : "VPC private subnet for AZ1",
      "ConstraintDescription" : "Must be an existing subnet in the selected Virtual Private Cloud."
    },
    "AZ2PrivateSubnetID" : {
      "Type" : "AWS::EC2::Subnet::Id",
      "Description" : "VPC private subnet for AZ2",
      "ConstraintDescription" : "Must be an existing subnet in the selected Virtual Private Cloud."
    },
    "ELBDevAccessSecurityGroup" : {
      "Type" : "AWS::EC2::SecurityGroup::Id",
      "Description" : "Id of an existing security group to give access to the ELB",
      "ConstraintDescription" : "Must be an existing security group in the selected Virtual Private Cloud."
    },
    "AppServerDevAccessSecurityGroup" : {
      "Type" : "AWS::EC2::SecurityGroup::Id",
      "Description" : "Id of an existing security group to give access to the App Server",
      "ConstraintDescription" : "Must be an existing security group in the selected Virtual Private Cloud."
    },
    "SSLCertARN": {
       "Description": "ARN of the SSL certificate",
       "MinLength": "1",
       "Type": "String",
       "ConstraintDescription": "SSL ARN cannot be null"
    },
    "SettingsType": {
       "Description": "Type of settings to apply",
       "Type": "String",
       "Default": "QA",
       "AllowedValues": [ "QA", "Staging", "Production" ]
    }
  },
  "Mappings" : {
     "Settings": {
        "QA": {
           "DBMultiAZ": "false",
           "DBRetentionPeriod": "7",
           "DBInstanceClass": "db.t3.small",
           "RedisNbNodes": "1",
           "RedisNodeType": "cache.t2.micro",
           "RedisAutomaticFailoverEnabled": "false",
           "RedisRetentionPeriod": "7",
           "LMSInstanceType": "t3.medium",
           "WilliamInstanceType": "t3.medium",
           "WellnessInstanceType": "t3.small",
           "WWWInstanceType": "t3.small"
        },
        "Staging": {
           "DBMultiAZ": "false",
           "DBRetentionPeriod": "7",
           "DBInstanceClass": "db.t3.small",
           "RedisNbNodes": "1",
           "RedisNodeType": "cache.t2.micro",
           "RedisAutomaticFailoverEnabled": "false",
           "RedisRetentionPeriod": "7",
           "LMSInstanceType": "t3.medium",
           "WilliamInstanceType": "t3.medium",
           "WellnessInstanceType": "t3.small",
           "WWWInstanceType": "t3.small"
        },
        "Production": {
           "DBMultiAZ": "true",
           "DBRetentionPeriod": "30",
           "DBInstanceClass": "db.t3.xlarge",
           "RedisNbNodes": "2",
           "RedisNodeType": "cache.r5.large",
           "RedisAutomaticFailoverEnabled": "true",
           "RedisRetentionPeriod": "30",
           "LMSInstanceType": "t3.xlarge",
           "WilliamInstanceType": "t3.xlarge",
           "WellnessInstanceType": "t3.medium",
           "WWWInstanceType": "t3.medium"
        }
     }
  },
  "Conditions": {
     "Production": { "Fn::Equals": [{ "Ref": "SettingsType" }, "Production"] },
     "Staging": { "Fn::Equals": [{ "Ref": "SettingsType" }, "Staging"] },
     "NotQA": { "Fn::Not" : [{ "Fn::Equals" : [ {"Ref" : "SettingsType"}, "QA" ] }] }
  },
  "Resources" : {
     "ELBSecurityGroup": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
           "VpcId": { "Ref": "VPC" },
           "GroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "ELB Security Group" ] ] },
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "ELB Security Group" ] ] }
           }]
        }
     },
     "AppServerSecurityGroup": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
           "VpcId": { "Ref": "VPC" },
           "GroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "AppServer Security Group" ] ] },
           "SecurityGroupIngress": [{
              "IpProtocol": "tcp",
              "FromPort": "8080",
              "ToPort": "8080",
              "SourceSecurityGroupId" : { "Ref" : "ELBSecurityGroup" },
              "Description": "HTTP Access from ELB port 8080"
           }],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "AppServer Security Group" ] ] }
           }]
        }
     },
     "WellnessServerSecurityGroup": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
           "VpcId": { "Ref": "VPC" },
           "GroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Wellness Server Security Group" ] ] },
           "SecurityGroupIngress": [{
              "IpProtocol": "tcp",
              "FromPort": "80",
              "ToPort": "80",
              "SourceSecurityGroupId" : { "Ref" : "ELBSecurityGroup" },
              "Description": "HTTP Access from ELB"
           }],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "AppServer Security Group" ] ] }
           }]
        }
     },
     "WWWServerSecurityGroup": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
           "VpcId": { "Ref": "VPC" },
           "GroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Www Server Security Group" ] ] },
           "SecurityGroupIngress": [{
              "IpProtocol": "tcp",
              "FromPort": "80",
              "ToPort": "80",
              "SourceSecurityGroupId" : { "Ref" : "ELBSecurityGroup" },
              "Description": "HTTP Access from ELB"
           }],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "AppServer Security Group" ] ] }
           }]
        }
     },
     "LMSServerRole": {
        "Type": "AWS::IAM::Role",
        "Properties": {
            "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
               {
                  "Effect": "Allow",
                  "Principal": { "Service": [ "ec2.amazonaws.com" ] },
                  "Action": [ "sts:AssumeRole" ]
               }
            ]
         },
         "Path": "/"
         }
     },
     "WilliamServerRole": {
        "Type": "AWS::IAM::Role",
        "Properties": {
            "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
               {
                  "Effect": "Allow",
                  "Principal": { "Service": [ "ec2.amazonaws.com" ] },
                  "Action": [ "sts:AssumeRole" ]
               }
            ]
         },
         "Path": "/"
         }
     },
     "AccessProdBackupS3BucketPolicy": {
        "Type": "AWS::IAM::Policy",
        "Properties": {
           "PolicyName": "AccessProdBackupS3BucketPolicy",
           "PolicyDocument": {
              "Statement": [
                 {
                    "Effect": "Allow",
                    "Action": [
                       "s3:ListBucket"
                    ],
                    "Resource": [
                       "arn:aws:s3:::uploan-prod-backups"
                    ]
                  },
                  {
                     "Effect": "Allow",
                     "Action": [
                        "s3:GetObject*",
                     ],
                     "Resource": [
                        "arn:aws:s3:::uploan-prod-backups/*"
                     ]
                   }
                ]
             },
             "Roles": [{ "Ref": "LMSServerRole" }]
         }
     },
     "WWWServerRole": {
        "Type": "AWS::IAM::Role",
        "Properties": {
            "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
               {
                  "Effect": "Allow",
                  "Principal": { "Service": [ "ec2.amazonaws.com" ] },
                  "Action": [ "sts:AssumeRole" ]
               }
            ]
         },
         "Path": "/"
         }
     },
     "WellnessServerRole": {
        "Type": "AWS::IAM::Role",
        "Properties": {
            "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
               {
                  "Effect": "Allow",
                  "Principal": { "Service": [ "ec2.amazonaws.com" ] },
                  "Action": [ "sts:AssumeRole" ]
               }
            ]
         },
         "Path": "/"
         }
     },
     "AllowSendAWSLogsPolicy": {
       "Type": "AWS::IAM::Policy",
       "Properties": {
          "PolicyName": "AllowSendAWSLogs",
          "PolicyDocument": {
             "Version": "2012-10-17",
             "Statement": [
             {
                "Effect": "Allow",
                "Action": [
                   "logs:CreateLogGroup",
                   "logs:CreateLogStream",
                   "logs:DescribeLogGroups",
                   "logs:DescribeLogStreams",
                   "logs:PutLogEvents"
                ],
                "Resource": "*"
             }]
           },
           "Roles": [
              { "Ref": "LMSServerRole" },
              { "Ref": "WilliamServerRole" },
              { "Ref": "WellnessServerRole" },
              { "Ref": "WWWServerRole" }
           ]
       }
     },
     "AllowEC2InfoPolicy": {
        "Type": "AWS::IAM::Policy",
        "Properties": {
           "PolicyName": "AllowAccessToEC2Info",
           "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
              {
                 "Effect": "Allow",
                 "Action": [
                    "ec2:DescribeInstanceStatus",
                    "ec2:DescribeTags"
                 ],
                 "Resource": "*"
              }]            
           },
          "Roles": [
              { "Ref": "LMSServerRole" },
              { "Ref": "WilliamServerRole" },
              { "Ref": "WellnessServerRole" },
              { "Ref": "WWWServerRole" }
           ]
        }
     },
     "DBSecurityGroup": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
           "VpcId": { "Ref": "VPC" },
           "GroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "DB Security Group" ] ] },
           "SecurityGroupIngress": [{
              "IpProtocol": "tcp",
              "FromPort": "3306",
              "ToPort": "3306",
              "SourceSecurityGroupId" : { "Ref" : "AppServerSecurityGroup" },
              "Description": "Access from AppServer"
           }],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "DB Security Group" ] ] }
           }]
        }
     },
     "RedisSecurityGroup": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
           "VpcId": { "Ref": "VPC" },
           "GroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Redis Security Group" ] ] },
           "SecurityGroupIngress": [{
              "IpProtocol": "tcp",
              "FromPort": "6379",
              "ToPort": "6379",
              "SourceSecurityGroupId" : { "Ref" : "AppServerSecurityGroup" },
              "Description": "Access from AppServer"
           }],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Redis Security Group" ] ] }
           }]
        }
     },
     "LMSServerInstanceProfile": {
        "Type": "AWS::IAM::InstanceProfile",
        "Properties": {
           "Path": "/",
           "Roles": [{
              "Ref": "LMSServerRole"
           }]
        }
     },
     "WilliamServerInstanceProfile": {
        "Type": "AWS::IAM::InstanceProfile",
        "Properties": {
           "Path": "/",
           "Roles": [{
              "Ref": "WilliamServerRole"
           }]
        }
     },
     "LMSInstance" : {
        "Type" : "AWS::EC2::Instance",
        "Properties" : {
           "KeyName" : { "Ref" : "KeyName" },
           "InstanceType" :  { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "LMSInstanceType" ] },
           "ImageId" : { "Ref" : "AppServerAMI" },
           "IamInstanceProfile": { "Ref": "LMSServerInstanceProfile" },
           "NetworkInterfaces" : [ {
              "DeviceIndex" : "0",
              "GroupSet" : [ { "Ref" : "AppServerDevAccessSecurityGroup" }, { "Ref": "AppServerSecurityGroup" } ],
              "SubnetId" : { "Ref" : "AZ1PublicSubnetID" }
            } ],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "LMS Server" ] ] }
           }]
         }
      },
      "LMSCPUAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "CPU Alarm for", { "Ref" : "AWS::StackName"}, "LMS Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "CPUUtilization",
            "Namespace" : "AWS/EC2",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "80",
            "ComparisonOperator" : "GreaterThanThreshold",
            "Dimensions" : [ {
               "Name" : "InstanceId",
               "Value" : { "Ref" : "LMSInstance" }
            }]
         }
      },
      "WilliamInstance" : {
        "Type" : "AWS::EC2::Instance",
        "Properties" : {
           "KeyName" : { "Ref" : "KeyName" },
           "InstanceType" : { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "WilliamInstanceType" ] },
           "ImageId" : { "Ref" : "AppServerAMI" },
           "IamInstanceProfile": { "Ref": "WilliamServerInstanceProfile" },
           "NetworkInterfaces" : [ {
              "DeviceIndex" : "0",
              "GroupSet" : [ { "Ref" : "AppServerDevAccessSecurityGroup" }, { "Ref": "AppServerSecurityGroup" } ],
              "SubnetId" : { "Ref" : "AZ2PublicSubnetID" }
            } ],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "William Server" ] ] }
           }]
         }
      },
      "WilliamCPUAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "CPU Alarm for", { "Ref" : "AWS::StackName"}, "William Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "CPUUtilization",
            "Namespace" : "AWS/EC2",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "80",
            "ComparisonOperator" : "GreaterThanThreshold",
            "Dimensions" : [ {
               "Name" : "InstanceId",
               "Value" : { "Ref" : "WilliamInstance" }
            }]
         }
      },
      "WellnessServerInstanceProfile": {
        "Type": "AWS::IAM::InstanceProfile",
        "Properties": {
           "Path": "/",
           "Roles": [{
              "Ref": "WellnessServerRole"
           }]
        }
      },
      "WellnessInstance" : {
        "Type" : "AWS::EC2::Instance",
        "Condition": "NotQA",
        "Properties" : {
           "KeyName" : { "Ref" : "KeyName" },
           "InstanceType" : { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "WellnessInstanceType" ] },
           "ImageId" : { "Ref" : "WellnessServerAMI" },
           "IamInstanceProfile": { "Ref": "WellnessServerInstanceProfile" },
           "NetworkInterfaces" : [ {
              "DeviceIndex" : "0",
              "GroupSet" : [ { "Ref" : "AppServerDevAccessSecurityGroup" }, { "Ref": "WellnessServerSecurityGroup" } ],
              "SubnetId" : { "Ref" : "AZ1PublicSubnetID" }
            } ],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Wellness Server" ] ] }
           }]
         }
      },
      "WellnessCPUAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Condition": "NotQA",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "CPU Alarm for", { "Ref" : "AWS::StackName"}, "Wellness Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "CPUUtilization",
            "Namespace" : "AWS/EC2",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "80",
            "ComparisonOperator" : "GreaterThanThreshold",
            "Dimensions" : [ {
               "Name" : "InstanceId",
               "Value" : { "Ref" : "WellnessInstance" }
            }]
         }
      },
      "WWWServerInstanceProfile": {
        "Type": "AWS::IAM::InstanceProfile",
        "Properties": {
           "Path": "/",
           "Roles": [{
              "Ref": "WWWServerRole"
           }]
        }
      },
      "WWWInstance" : {
        "Type" : "AWS::EC2::Instance",
        "Condition": "NotQA",
        "Properties" : {
           "KeyName" : { "Ref" : "KeyName" },
           "InstanceType" : { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "WWWInstanceType" ] },
           "ImageId" : { "Ref" : "WWWServerAMI" },
           "IamInstanceProfile": { "Ref": "WWWServerInstanceProfile" },
           "NetworkInterfaces" : [ {
              "DeviceIndex" : "0",
              "GroupSet" : [ { "Ref" : "AppServerDevAccessSecurityGroup" }, { "Ref": "WWWServerSecurityGroup" } ],
              "SubnetId" : { "Ref" : "AZ2PublicSubnetID" }
            } ],
           "Tags": [{
              "Key": "Name",
              "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "WWW Server" ] ] }
           }]
         }
      },
      "WWWCPUAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Condition": "NotQA",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "CPU Alarm for", { "Ref" : "AWS::StackName"}, "Wellness Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "CPUUtilization",
            "Namespace" : "AWS/EC2",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "80",
            "ComparisonOperator" : "GreaterThanThreshold",
            "Dimensions" : [ {
               "Name" : "InstanceId",
               "Value" : { "Ref" : "WellnessInstance" }
            }]
         }
      },
      "RedisSubnetGroup": {
         "Type": "AWS::ElastiCache::SubnetGroup",
         "Properties": {
            "Description": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Redis Subnet Group" ] ] },
            "SubnetIds": [
               { "Ref": "AZ1PrivateSubnetID" },
               { "Ref": "AZ2PrivateSubnetID" }
            ]
         }
      },
      "DBSubnetGroup": {
         "Type": "AWS::RDS::DBSubnetGroup",
         "Properties": {
            "DBSubnetGroupDescription": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "DB Subnet Group" ] ] },
            "SubnetIds": [
               { "Ref": "AZ1PrivateSubnetID" },
               { "Ref": "AZ2PrivateSubnetID" }
            ],
            "Tags": [{  
               "Key": "Name",
               "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "DB Subnet Group" ] ] }
            }]
         }
      },
      "DBParameterGroup": {
         "Type": "AWS::RDS::DBParameterGroup",
         "DeletionPolicy": "Delete",
         "Properties" : {
            "Description": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "DB Parameter Group" ] ] },
            "Family" : "MySQL5.7",
            "Parameters" : {
               "sql_mode": "IGNORE_SPACE"
            }
         }
      },
      "DBInstanceMonitoringRole": {
         "Type": "AWS::IAM::Role",
         "Properties": {
             "AssumeRolePolicyDocument": {
             "Version": "2012-10-17",
             "Statement": [
             {
                "Sid": "",
                "Effect": "Allow",
                "Principal": {
                   "Service": "monitoring.rds.amazonaws.com"
                },
                "Action": "sts:AssumeRole"
             }
          ]},
          "ManagedPolicyArns": [
            "arn:aws:iam::aws:policy/service-role/AmazonRDSEnhancedMonitoringRole"
          ],
          "Path": "/"
          }
      },
      "DBInstance": {
         "Type": "AWS::RDS::DBInstance",
         "Properties": {
            "AllocatedStorage": 20,
            "DBInstanceClass": { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "DBInstanceClass" ] },
            "Engine": "MySQL",
            "EngineVersion": "5.7.22",
            "MasterUsername": "root",
            "MasterUserPassword": "password",
            "Tags": [{
               "Key": "Name",
               "Value": { "Fn::Join": [ " ", [ { "Ref" : "AWS::StackName"}, "Database" ] ] }
            }],
            "StorageEncrypted": true,
            "StorageType": "gp2",
            "PubliclyAccessible": false,
            "DBSubnetGroupName": { "Ref": "DBSubnetGroup" },
            "MultiAZ": { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "DBMultiAZ" ] },
            "VPCSecurityGroups": [ { "Ref": "DBSecurityGroup" } ],
            "DBParameterGroupName": { "Ref": "DBParameterGroup" },
            "MonitoringInterval": "10",
            "MonitoringRoleArn": { "Fn::GetAtt": [ "DBInstanceMonitoringRole", "Arn" ]},
            "CopyTagsToSnapshot": "true",
            "BackupRetentionPeriod": { "Fn::FindInMap": [ "Settings", { "Ref": "SettingsType" }, "DBRetentionPeriod" ] },
            "AutoMinorVersionUpgrade": true
        },
        "DeletionPolicy": "Snapshot"
    },
    "DBRoute53Record" : {
       "DependsOn" : "DBInstance",
       "Type" : "AWS::Route53::RecordSet",
       "Properties" : {
          "HostedZoneName" : { "Fn::Join" : [ "", [ { "Ref" : "LocalDomainName" }, "." ]]},
          "Comment" : "Local DNS for DB",
          "Name" : {
             "Fn::Join" : [ "", [
                {"Ref" : "AWS::StackName"}, ".db.",
                {"Ref" : "LocalDomainName"} ,"."
             ] ]
          },
          "Type" : "CNAME",
          "TTL" : "60",
          "ResourceRecords" : [
             { "Fn::GetAtt" : [ "DBInstance", "Endpoint.Address" ] }
          ]
       }
    },
    "DBCPUAlarm" : {
         "Type" : "AWS::CloudWatch::Alarm",
         "Properties" : {
            "AlarmDescription" : { "Fn::Join": [ " ", [ "CPU Alarm for", { "Ref" : "AWS::StackName"}, "DB Server" ] ] },
            "AlarmActions" : [ ],
            "MetricName" : "CPUUtilization",
            "Namespace" : "AWS/RDS",
            "Statistic" : "Average",
            "Period" : "60",
            "EvaluationPeriods" : "3",
            "Threshold" : "80",
            "ComparisonOperator" : "GreaterThanThreshold",
