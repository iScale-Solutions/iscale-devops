# Deploy iscale-dev-network stack (for staging, since we need to cut cost as possible, 
# I am using the existing network stack because of the ALB location)
aws cloudformation create-stack \
    --stack-name iscale-internal-dev-uw2-chatbotai-network \
    --template-body file://../iscale-dev-network.yaml \
    --parameters file://chatbot-network-parameters.json \
    --capabilities CAPABILITY_NAMED_IAM \
    --tags Key=System,Value=CHATBOTAI Key=Environment,Value=Development
# Delete stack
aws cloudformation delete-stack \
    --stack-name iscale-internal-dev-uw2-chatbotai-network



###
# Deploy chatbotai stack
###
cd ~/Documents/Projects/iscale/iscale-devops/iscale-dev/chatbotai
# Create the stack
aws cloudformation create-stack \
    --stack-name iscale-dev-dev-uw2-chatbotai \
    --template-body file://chatbotai.yaml \
    --parameters file://chatbot-parameters.json \
    --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND \
    --tags Key=System,Value=CHATBOTAI Key=Environment,Value=Development
# Update the stack
aws cloudformation update-stack \
    --stack-name iscale-dev-dev-uw2-chatbotai \
    --template-body file://chatbotai.yaml \
    --parameters file://chatbot-parameters.json \
    --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND \
    --tags Key=System,Value=CHATBOTAI Key=Environment,Value=Development
# Check the stack status
aws cloudformation describe-stacks \
    --stack-name iscale-dev-dev-uw2-chatbotai \
    --query "Stacks[0].StackStatus" \
    --output text
# Check the stack events
aws cloudformation describe-stack-events \
    --stack-name iscale-dev-dev-uw2-chatbotai \
    --query "StackEvents[?ResourceStatus=='CREATE_COMPLETE' || ResourceStatus=='UPDATE_COMPLETE'].[Timestamp, ResourceType, ResourceStatus]" \
    --output table
# Check the stack resources
aws cloudformation describe-stack-resources \
    --stack-name iscale-dev-dev-uw2-chatbotai \
    --query "StackResources[].[LogicalResourceId, ResourceType, ResourceStatus]" \
    --output table
# Destroy the stack
aws cloudformation delete-stack \
    --stack-name iscale-dev-dev-uw2-chatbotai
