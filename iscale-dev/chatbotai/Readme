# Deploy iscale-dev-network stack
aws cloudformation create-stack \
    --stack-name iscale-internal-dev-uw2-chatbotai-network \
    --template-body file://../iscale-dev-network.yaml \
    --parameters file://chatbot-network-parameters.json \
    --capabilities CAPABILITY_NAMED_IAM \
    --tags Key=System,Value=CHATBOTAI Key=Environment,Value=Development

# Deploy chatbotai stack
aws cloudformation create-stack \
    --stack-name iscale-internal-dev-uw2-chatbotai \
    --template-body file://iscale-dev-chatbotai.yaml \
    --parameters file://chatbot-parameters.json \
    --capabilities CAPABILITY_NAMED_IAM \
    --tags Key=System,Value=CHATBOTAI Key=Environment,Value=Development

