{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "eSports Masterclass Deployment",
    "Parameters": {
        "GlobalDomainName": {
            "Description": "Global domain name",
            "MinLength": "1",
            "Type": "String",
            "Default": "esportmasterclass.com",
            "ConstraintDescription": "Domain Name cannot be empty"
        },
        "NetworkStack": {
            "Description": "Name of the Network Stack",
            "MinLength": "1",
            "Type": "String",
            "ConstraintDescription": "Network stack Name cannot be null"
        },
        "ELBStack": {
            "Description": "Name of the ELB Stack",
            "MinLength": "1",
            "Type": "String",
            "ConstraintDescription": "ELB stack Name cannot be null"
        },
        "AppServerAMI": {
           "Description": "Name of AppServer AMI",
           "MinLength": "1",
           "Type": "AWS::EC2::Image::Id",
           "ConstraintDescription": "AppServer AMI cannot be null"
        },
        "PublicELBSecurityGroup": {
         "Description": "Name of the public ELB Security Group",
         "MinLength": "1",
         "Type": "String",
         "ConstraintDescription": "AppServer AMI cannot be null"
        }
    },
    "Conditions": {
    },
    "Mappings": {
    },
    "Resources": {
      "HostedZone": {
         "Type": "AWS::Route53::HostedZone",
            "Properties": {
               "HostedZoneConfig": {
                  "Comment": { "Fn::Join": [ " ", ["Hosted Zone for", { "Ref": "GlobalDomainName" } ] ] }
               },
               "Name": { "Ref": "GlobalDomainName" }
            }
      },
      "DomainMXRecord": {
         "Type": "AWS::Route53::RecordSet",
         "DependsOn" : "HostedZone",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "MX Record",
            "Name": { "Fn::Join": [ ".", [ "@", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "MX",
            "TTL": "3600",
            "ResourceRecords": [
               "0 esportmasterclass-com.mail.protection.outlook.com.",
            ]
         }
      },
      "AutoDiscoverCNAMERecord": {
         "Type": "AWS::Route53::RecordSet",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "Autodiscover CNAME record",
            "Name": { "Fn::Join": [ ".", [ "autodiscover", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "CNAME",
            "TTL": "3600",
            "ResourceRecords": [
               "autodiscover.outlook.com."
            ]
         }
      },
      "SipCNAMERecord": {
         "Type": "AWS::Route53::RecordSet",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "Sip CNAME record",
            "Name": { "Fn::Join": [ ".", [ "sip", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "CNAME",
            "TTL": "3600",
            "ResourceRecords": [
               "sipdir.online.lync.com."
            ]
         }
      },
      "LyncDiscoverCNAMERecord": {
         "Type": "AWS::Route53::RecordSet",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "LyncDiscover CNAME record",
            "Name": { "Fn::Join": [ ".", [ "lyncdiscover", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "CNAME",
            "TTL": "3600",
            "ResourceRecords": [
               "webdir.online.lync.com."
            ]
         }
      },
      "EnterpriseRegistrationCNAMERecord": {
         "Type": "AWS::Route53::RecordSet",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "EnterpriseRegistration CNAME record",
            "Name": { "Fn::Join": [ ".", [ "enterpriseregistration", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "CNAME",
            "TTL": "3600",
            "ResourceRecords": [
               "enterpriseregistration.windows.net."
            ]
         }
      },
      "EnterpriseEnrollmentCNAMERecord": {
         "Type": "AWS::Route53::RecordSet",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "EnterpriseEnrollment CNAME record",
            "Name": { "Fn::Join": [ ".", [ "enterpriseenrollment", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "CNAME",
            "TTL": "3600",
            "ResourceRecords": [
               "enterpriseenrollment.manage.windows.com."
            ]
         }
      },
      "DomainTxtRecord": {
         "Type": "AWS::Route53::RecordSet",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "Outlook verification TXT record",
            "Name": { "Fn::Join": [ ".", [ "@", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "TXT",
            "TTL": "3600",
            "ResourceRecords": [
               '"v=spf1 include:spf.protection.outlook.com -all"'
            ]
         }
      },
      "SipTlsSRVRecord": {
         "Type": "AWS::Route53::RecordSet",
         "DependsOn" : "HostedZone",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "_sip.tls SRV Record",
            "Name": { "Fn::Join": [ ".", [ "_sip.tls", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "SRV",
            "TTL": "3600",
            "ResourceRecords": [
               "100 1 443 sipdir.online.lync.com.",
            ]
         }
      },
      "SipFedSRVRecord": {
         "Type": "AWS::Route53::RecordSet",
         "DependsOn" : "HostedZone",
         "Properties": {
            "HostedZoneName": { "Fn::Join": [ "", [ { "Ref": "GlobalDomainName" }, "." ] ] },
            "Comment": "_sipfederationtls._tcp SRV Record",
            "Name": { "Fn::Join": [ ".", [ "_sipfederationtls._tcp", { "Ref": "GlobalDomainName" } ] ] },
            "Type": "SRV",
            "TTL": "3600",
            "ResourceRecords": [
               "100 1 5061 sipfed.online.lync.com.",
            ]
         }
      },
      "AppServerTargetGroup": {
         "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
         "Properties": {
             "HealthCheckIntervalSeconds": "10",
             "HealthCheckProtocol": "HTTP",
             "HealthCheckTimeoutSeconds": "2",
             "HealthyThresholdCount": "2",
             "UnhealthyThresholdCount": "3",
             "HealthCheckPath": "/health.php",
             "Matcher": { "HttpCode": "200" },
             "Port": "80",
             "Protocol": "HTTP",
             "TargetGroupAttributes": [],
             "Targets": [{ "Id": {"Ref" : "AppServerInstance"}, "Port": 80 }],
             "TargetType": "instance",
             "VpcId": { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-VPC" } },
             "Tags": [{
                "Key": "Name",
                "Value": { "Fn::Join": [ " ", [ { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-SetupName"} }, "eSport AppServer Target Group" ] ] }
             }]
         }
      },
      "HTTPListenerRule": {
         "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
         "Properties": {
            "Actions": [{
               "Type": "forward",
               "TargetGroupArn": { "Ref": "AppServerTargetGroup" }
            }],
            "Conditions": [{
               "Field": "host-header",
               "Values": [ { "Fn::Join": [ "", [ "*.", "Ref": "GlobalDomainName" ] ] } ]
            }],
            "ListenerArn": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-HTTPListener"} },
            "Priority": 801
         }
      },
      "HTTPListenerRuleDomain": {
         "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
         "Properties": {
            "Actions": [{
               "Type": "forward",
               "TargetGroupArn": { "Ref": "AppServerTargetGroup" }
            }],
            "Conditions": [{
               "Field": "host-header",
               "Values": [{ "Ref": "GlobalDomainName" }]
            }],
            "ListenerArn": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-HTTPListener"} },
            "Priority": 802
         }
      },
      "SSLListenerRule": {
         "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
         "Properties": {
            "Actions": [{
               "Type": "forward",
               "TargetGroupArn": { "Ref": "AppServerTargetGroup" }
            }],
            "Conditions": [{
               "Field": "host-header",
               "Values": [ { "Fn::Join": [ "", [ "*.", "Ref": "GlobalDomainName" ] ] } ]
            }],
            "ListenerArn": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-SSLListener"} },
            "Priority": 801
         }
      },
      "SSLListenerRuleDomain": {
         "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
         "Properties": {
            "Actions": [{
               "Type": "forward",
               "TargetGroupArn": { "Ref": "AppServerTargetGroup" }
            }],
            "Conditions": [{
               "Field": "host-header",
               "Values": [{ "Ref": "GlobalDomainName" }]
            }],
            "ListenerArn": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-SSLListener"} },
            "Priority": 802
         }
       },
       "AppServerRole": {
          "Type": "AWS::IAM::Role",
          "Properties": {
             "AssumeRolePolicyDocument": {
                "Version": "2012-10-17",
                "Statement": [
                   {
                      "Effect": "Allow",
                      "Principal": { "Service": [ "ec2.amazonaws.com" ] },
                            "Action": [ "sts:AssumeRole" ]
                   }
                ]
             },
             "Path": "/"
          }
       },
       "AllowSendAWSLogsPolicy": {
         "Type": "AWS::IAM::Policy",
         "Properties": {
            "PolicyName": "AllowSendAWSLogs",
            "PolicyDocument": {
               "Version": "2012-10-17",
               "Statement": [
               {
                  "Effect": "Allow",
                  "Action": [
                     "logs:CreateLogGroup",
                     "logs:CreateLogStream",
                     "logs:DescribeLogGroups",
                     "logs:DescribeLogStreams",
                     "logs:PutLogEvents"
                  ],
                  "Resource": "*"
               }]
             },
             "Roles": [{ "Ref": "AppServerRole" }]
          }
       },
       "AllowEC2InfoPolicy": {
         "Type": "AWS::IAM::Policy",
         "Properties": {
            "PolicyName": "AllowAccessToEC2Info",
            "PolicyDocument": {
               "Version": "2012-10-17",
               "Statement": [
               {
                  "Effect": "Allow",
                  "Action": [
                     "ec2:DescribeInstanceStatus",
                     "ec2:DescribeTags"
                  ],
                  "Resource": "*"
               }]
            },
            "Roles": [{ "Ref": "AppServerRole" }]
          }
       },
       "AppServerSecurityGroup": {
          "Type": "AWS::EC2::SecurityGroup",
          "Properties": {
             "VpcId": { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-VPC"} },
             "GroupDescription": { "Fn::Join": [ " ", [ { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-SetupName"} }, "eSport AppServer Security Group" ] ] },
             "SecurityGroupIngress": [
                {
                   "IpProtocol": "tcp",
                   "FromPort": "22",
                   "ToPort": "22",
                   "SourceSecurityGroupId": { "Fn::ImportValue": { "Fn::Sub": "${NetworkStack}-BastionSecurityGroup" } },
                   "Description": "SSH Access from Bastion"
                },
                {
                   "IpProtocol": "tcp",
                   "FromPort": "80",
                   "ToPort": "80",
                   "SourceSecurityGroupId": { "Ref": "PublicELBSecurityGroup" },
                   "Description": "HTTP Access from Public ELB"
                }
             ],
             "Tags": [{
                "Key": "Name",
                "Value": { "Fn::Join": [ " ", [ { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-SetupName"} }, "eSport AppServer Security Group" ] ] }
             }]
          }
      },
      "AppServerRole": {
          "Type": "AWS::IAM::Role",
          "Properties": {
             "AssumeRolePolicyDocument": {
                "Version": "2012-10-17",
                   "Statement": [
                      {
                         "Effect": "Allow",
                         "Principal": {
                         "Service": [
                            "ec2.amazonaws.com"
                            ]
                         },
                         "Action": [
                            "sts:AssumeRole"
                         ]
                      }
                  ]
               },
               "Path": "/"
            }
        },
       "AppServerInstanceProfile": {
            "Type": "AWS::IAM::InstanceProfile",
            "Properties": {
                "Path": "/",
                "Roles": [
                    {
                        "Ref": "AppServerRole"
                    }
                ]
            }
      },
      "AppServerInstance": {
         "Type": "AWS::EC2::Instance",
         "Properties": {
            "ImageId": { "Ref": "AppServerAMI" },
            "KeyName": { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-InstanceKeyName"} },
            "InstanceType": "t3.medium",
            "IamInstanceProfile": { "Ref": "AppServerInstanceProfile" },
            "DisableApiTermination": false,
            "NetworkInterfaces": [ {
               "AssociatePublicIpAddress": "false",
               "DeviceIndex": "0",
               "GroupSet": [ 
                  { "Ref": "AppServerSecurityGroup" }
               ],
               "SubnetId": { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-PrivateSubnetAZ1"} }
            }],
            "Tags": [{
               "Key": "Name",
               "Value": { "Fn::Join": [ " ", [ { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-SetupName"} }, "eSport AppServer Instance" ] ] },
             },
             {
               "Key": "Retention",
               "Value": "60",
             },
             {
                "Key": "LambdaBackupConfiguration",
                "Value": "30,8,12,2"
             }]
          }
      },
      "EFS": {
         "Type": "AWS::EFS::FileSystem",
         "Properties": {
             "Encrypted": "true"
         }
      },
      "EFSSecurityGroup": {
          "Type": "AWS::EC2::SecurityGroup",
          "Properties": {
             "VpcId": { "Fn::ImportValue": { "Fn::Sub": "${NetworkStack}-VPC"} },
             "GroupDescription": { "Fn::Join": [ " ", [ { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-SetupName"} }, "eSport EFS Security Group" ] ] },
             "SecurityGroupIngress": [
                {
                   "IpProtocol": "tcp",
                   "FromPort": "2049",
                   "ToPort": "2049",
                   "SourceSecurityGroupId": { "Ref": "AppServerSecurityGroup" },
                   "Description": "EFS Access from AppServer"
                }
             ],
             "Tags": [{
                "Key": "Name",
                "Value": { "Fn::Join": [ " ", [ { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-SetupName"} }, "eSport EFS Security Group" ] ] }
             }]
          }
      },
      "EFSMountTargetAZ1": {
         "Type": "AWS::EFS::MountTarget",
         "Properties": {
            "FileSystemId": { "Ref": "EFS" },
            "SubnetId": { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-PrivateSubnetAZ1"} },
            "SecurityGroups": ["Ref": "EFSSecurityGroup" ]
         }
      },
      "EFSMountTargetAZ2": {
         "Type": "AWS::EFS::MountTarget",
         "Properties": {
             "FileSystemId": { "Ref": "EFS" },
             "SubnetId": { "Fn::ImportValue": {"Fn::Sub": "${NetworkStack}-PrivateSubnetAZ2"} },
             "SecurityGroups": ["Ref": "EFSSecurityGroup" ]
         }
      },
      "EFSRoute53Record": {
          "Type": "AWS::Route53::RecordSet",
          "Properties": {
             "HostedZoneId": { "Fn::ImportValue" : { "Fn::Sub" : "${NetworkStack}-LocalDNSHostedZoneId" } },
             "Comment": "Local DNS for DB",
             "Name": { "Fn::Join": [ "", [ "efs.esport.", { "Fn::ImportValue": { "Fn::Sub" : "${NetworkStack}-LocalDomainName" } } ] ] },
             "Type": "CNAME",
             "TTL": "3600",
             "ResourceRecords": [
                { "Fn::Join": [ ".", [ { "Ref": "EFS" }, "efs", "Ref": "AWS::Region", "amazonaws.com"] ] } 
             ]
         }
      },
      "HostedZone": {
         "Type": "AWS::Route53::HostedZone",
            "Properties": {
               "HostedZoneConfig": {
                  "Comment": { "Fn::Join": [ " ", ["INACTIVE Hosted Zone for", { "Ref": "GlobalDomainName" } ] ] }
               },
               "Name": { "Ref": "GlobalDomainName" }
            }
      },
      "WWWRecord": {
         "Type": "AWS::Route53::RecordSetGroup",
         "Properties": {
            "HostedZoneId": { "Ref": "HostedZone" },
            "Comment": "WWW Record",
            "RecordSets" : [{
               "Name": { "Fn::Join": [ "", ["www.", { "Ref": "GlobalDomainName" }, "." ] ] },
               "Type": "A",
               "AliasTarget": {
                  "HostedZoneId": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-PublicELBCanonicalHostedZoneID"} },
                  "DNSName": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-PublicELBDNS"} }
               }
            }]
         }
      },
      "NoWWWRecord": {
         "Type": "AWS::Route53::RecordSetGroup",
         "Properties": {
            "HostedZoneId": { "Ref": "HostedZone" },
            "Comment": "No WWW Record",
            "RecordSets" : [{
               "Name": { "Ref": "GlobalDomainName" },
               "Type": "A",
               "AliasTarget": {
                  "HostedZoneId": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-PublicELBCanonicalHostedZoneID"} },
                  "DNSName": { "Fn::ImportValue": {"Fn::Sub": "${ELBStack}-PublicELBDNS"} }
               }
            }]
         }
      }
   },
   "Outputs": {
   }
}
